#define VERSION_NUMBER @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_REVISION@,@VERSION_EXTRA@
#define VERSION_NUMBER_STR "@VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_REVISION@,@VERSION_EXTRA@"

#include <winuser.h>

#ifdef VLC_REDESIGN_BRANDING
VLC_ICON ICON "vlc-redesign.ico"
# define VLC_RC_COMPANY     "VLC Redesign (unofficial)"
# define VLC_RC_PRODUCT     "VLC Redesign (unofficial)"
# define VLC_RC_DESCRIPTION "VLC Redesign (unofficial) - based on VLC media player by VideoLAN"
# define VLC_RC_COPYRIGHT   "Copyright \251 @COPYRIGHT_YEARS@ VideoLAN and VLC Authors. Design by Juxtopposed. Unofficial, not affiliated with VideoLAN."
#else
VLC_ICON ICON "vlc.ico"
# define VLC_RC_COMPANY     "VideoLAN"
# define VLC_RC_PRODUCT     "VLC media player"
# define VLC_RC_DESCRIPTION "VLC media player"
# define VLC_RC_COPYRIGHT   "Copyright \251 @COPYRIGHT_YEARS@ VideoLAN and VLC Authors"
#endif

1 VERSIONINFO
FILETYPE 1
FILEOS 4
PRODUCTVERSION VERSION_NUMBER
FILEVERSION VERSION_NUMBER
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", VLC_RC_COMPANY
      VALUE "ProductName", VLC_RC_PRODUCT
      VALUE "ProductVersion", VERSION_NUMBER_STR
      VALUE "InternalName", "vlc"
      VALUE "OriginalFilename", "vlc.exe"
      VALUE "FileVersion", "@VERSION@"
      VALUE "FileDescription", VLC_RC_DESCRIPTION
      VALUE "LegalCopyright", VLC_RC_COPYRIGHT
      VALUE "LegalTrademarks", "VLC media player, VideoLAN and x264 are registered trademarks from VideoLAN"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "vlc.exe.manifest"
